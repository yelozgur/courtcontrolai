// CourtControlAI — Multi-Tenant Prisma Schema
// db-cargo (Vercel Postgres/Neon) — schema_courtcontrolai altında
// NextAuth.js adapter için User/Account/Session modelleri dahil

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["schema_courtcontrolai"]
}

// ===== Tournament Domain =====

model Club {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  ownerId     String
  adminIds    String[]
  description String?
  logoUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tournaments Tournament[]
  teams       Team[]
  venues      Venue[]

  @@schema("schema_courtcontrolai")
}

model Team {
  id           String   @id @default(uuid())
  name         String
  tournamentId String
  clubId       String
  playerIds    String[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  club       Club       @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([tournamentId])
  @@schema("schema_courtcontrolai")
}

// ===== Phase 1: Physical resources =====

model Venue {
  id        String   @id @default(uuid())
  clubId    String
  name      String
  openHours Json? // {"mon":[["HH:MM","HH:MM"]], ...}; null = no info / open all day
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  club   Club    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  courts Court[]

  @@index([clubId])
  @@schema("schema_courtcontrolai")
}

model Court {
  id        String   @id @default(uuid())
  venueId   String
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  venue   Venue   @relation(fields: [venueId], references: [id], onDelete: Cascade)
  matches Match[]

  @@index([venueId])
  @@schema("schema_courtcontrolai")
}

// ===== Phase 1: Registration =====

model Registration {
  id            String   @id @default(uuid())
  tournamentId  String
  userId        String?
  displayName   String
  email         String
  categoryId    String?
  skillLevel    String?
  paymentStatus String   @default("waived")
  paidAmount    Decimal  @default(0)
  skipped       Boolean  @default(false)
  skipReason    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  category   Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  checkIns   CheckIn[]

  @@index([tournamentId])
  @@index([email])
  @@index([categoryId])
  @@schema("schema_courtcontrolai")
}

model CheckIn {
  id             String   @id @default(uuid())
  registrationId String
  scannedAt      DateTime @default(now())
  method         String   @default("qr")
  scannedBy      String?

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([registrationId])
  @@index([scannedAt])
  @@schema("schema_courtcontrolai")
}

model Tournament {
  id        String           @id @default(uuid())
  name      String
  slug      String           @unique
  clubId    String
  status    TournamentStatus @default(PLANNED)
  startsAt  DateTime
  endsAt    DateTime?
  settings  Json? // bracket type (single/double elim), max players, etc.
  preferences Json? // Stage 2: last-used schedule preferences (SEL-93)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  club          Club           @relation(fields: [clubId], references: [id], onDelete: Cascade)
  matches       Match[]
  bracket       Bracket?
  teams         Team[]
  categories    Category[]
  registrations Registration[]
  scheduleRuns  ScheduleRun[]

  @@index([status, startsAt])
  @@schema("schema_courtcontrolai")
}

model Category {
  id           String   @id @default(uuid())
  tournamentId String
  name         String
  slug         String
  minAge       Int?
  maxAge       Int?
  gender       String?
  teamSize     Int      @default(1)
  matchMinutes Int      @default(60)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tournament    Tournament     @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  registrations Registration[]
  matches       Match[]

  @@unique([tournamentId, slug])
  @@index([tournamentId])
  @@schema("schema_courtcontrolai")
}

enum TournamentStatus {
  PLANNED
  REGISTRATION
  RUNNING
  COMPLETED
  CANCELLED

  @@schema("schema_courtcontrolai")
}

model Match {
  id           String      @id @default(uuid())
  tournamentId String
  categoryId   String?
  courtId      String?
  round        Int
  position     Int // position within round
  player1Id    String?
  player2Id    String?
  score1       Int         @default(0)
  score2       Int         @default(0)
  scheduledAt  DateTime?
  playedAt     DateTime?
  status       MatchStatus @default(SCHEDULED)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  category   Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  court      Court?     @relation(fields: [courtId], references: [id], onDelete: SetNull)

  @@index([tournamentId, round, position])
  @@index([categoryId])
  @@index([courtId])
  @@schema("schema_courtcontrolai")
}

enum MatchStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  WALKOVER
  DISQUALIFIED

  @@schema("schema_courtcontrolai")
}

model Bracket {
  id           String   @id @default(uuid())
  tournamentId String   @unique
  data         Json // bracket tree structure
  version      Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@schema("schema_courtcontrolai")
}

// ===== Schedule Verification =====

model ScheduleRun {
  id              String           @id @default(uuid())
  tournamentId    String
  solverStatus    String
  verifiedStatus  ScheduleVerifyStatus @default(PENDING)
  violations      Json?
  makespanMinutes Int?
  assignmentCount Int              @default(0)
  createdAt       DateTime         @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId, createdAt])
  @@schema("schema_courtcontrolai")
}

enum ScheduleVerifyStatus {
  PENDING
  PASSED
  FAILED

  @@schema("schema_courtcontrolai")
}

// ===== AI Flow Queue =====

model AIQueue {
  id          String        @id @default(uuid())
  type        String // 'bracket-flow', 'optimize-schedule', 'optimize-schedule-tsp'
  status      AIQueueStatus @default(PENDING)
  input       Json
  output      Json?
  error       String?
  attempts    Int           @default(0)
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime      @default(now())

  @@index([status, createdAt])
  @@schema("schema_courtcontrolai")
}

enum AIQueueStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED

  @@schema("schema_courtcontrolai")
}

// ===== NextAuth.js Models =====

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  role          UserRole  @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  @@schema("schema_courtcontrolai")
}

enum UserRole {
  USER
  ADMIN
  TOURNAMENT_DIRECTOR

  @@schema("schema_courtcontrolai")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@schema("schema_courtcontrolai")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("schema_courtcontrolai")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@schema("schema_courtcontrolai")
}
