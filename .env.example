# CourtControl AI — Environment Variables
# Bu dosya repoya commit edilir, gercek secret'ler icermez.
# Gercek degerler icin .env.local kullan (gitignore'da).

# === Firebase Emulator Mode (Local Dev) ===
# true ise Firestore + Auth localhost'a baglanir (8080, 9099).
# Prod'da bu satir olmamali veya false olmali.
NEXT_PUBLIC_USE_EMULATOR=true

# === Firebase config (gercek degerler prod'da) ===
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# === Genkit / Google AI ===
# GOOGLE_GENAI_API_KEY tanimlanmazsa (veya placeholder kalirsa) tum AI ozellikleri
# kapali olur: skor optimizasyonu, AI otomatik planlama. 503 + "ai_not_configured"
# doner. Anahtar set edilince otomatik acilir — baska degisiklik gerekmez.
GOOGLE_GENAI_API_KEY=your_google_ai_key

# === Telegram (opsiyonel, sadece production'da gerekli) ===
TELEGRAM_BOT_TOKEN=

# === NextAuth.js (Google OAuth) ===
# Google Cloud Console > Credentials > OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# NextAuth JWT encryption secret (openssl rand -base64 32)
AUTH_SECRET=your-auth-secret

# === Test-only auth provider (E2E over HTTP) ===
# When AUTH_TEST_ENABLED=true, a "test-session" credentials provider is registered.
# Authenticate with POST /api/auth/callback/test-session using AUTH_TEST_TOKEN.
# NEVER set AUTH_TEST_ENABLED=true in production.
AUTH_TEST_ENABLED=false
AUTH_TEST_TOKEN=
AUTH_TEST_USER_EMAIL=test@courtcontrolai.local

# === Firebase Admin SDK (NextAuth bridge) ===
# Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_ADMIN_PROJECT_ID=courtcontrolai-2294b
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# === Neon Postgres (Prisma datasource) ===
# Neon dashboard'dan (https://console.neon.tech) alinacak.
# "Connection Details" > "Pooled Connection" -> POSTGRES_PRISMA_URL
# "Connection Details" > "Direct Connection" -> POSTGRES_URL_NON_POOLING
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host.neon.tech/dbname?sslmode=require"
POSTGRES_PRISMA_URL="postgresql://user:password@host-pooler.neon.tech/dbname?channel_binding=require&connect_timeout=15&sslmode=require"
POSTGRES_URL_NON_POOLING="postgresql://user:password@host.neon.tech/dbname?channel_binding=require&sslmode=require"
POSTGRES_URL="postgresql://user:password@host-pooler.neon.tech/dbname?channel_binding=require&sslmode=require"
POSTGRES_URL_NO_SSL="postgresql://user:password@host-pooler.neon.tech/dbname"
POSTGRES_HOST="host-pooler.neon.tech"
POSTGRES_HOST_UNPOOLED="host.neon.tech"
POSTGRES_DATABASE="dbname"
POSTGRES_USER="user"
POSTGRES_PASSWORD="password"
PGHOST="host-pooler.neon.tech"
PGHOST_UNPOOLED="host.neon.tech"
PGDATABASE="dbname"
PGUSER="user"
PGPASSWORD="password"
NEON_PROJECT_ID="your-neon-project-id"
NEON_AUTH_BASE_URL="https://host.neonauth.neon.tech/dbname/auth"
VITE_NEON_AUTH_URL="https://host.neonauth.neon.tech/dbname/auth"
