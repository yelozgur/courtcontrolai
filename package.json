{
  "name": "courtcontrolai",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 9002",
    "genkit:dev": "genkit start -- tsx src/ai/dev.ts",
    "genkit:watch": "genkit start -- tsx --watch src/ai/dev.ts",
    "emulator": "firebase emulators:start --project demo-app",
    "emulator:ui": "firebase emulators:start --project demo-app --only ui",
    "build": "NODE_ENV=production next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "format": "prettier --write \"src/**/*.{ts,tsx,md}\"",
    "analyze": "ANALYZE=true next build",
    "watchdog": "node scripts/watchdog.mjs",
    "marketing": "node scripts/marketing-bot.mjs",
    "test:seed": "node test-seed.cjs",
    "test:functional": "echo 'Functional tests: open TEST_PLAN.md, follow the 60-test plan manually or via Playwright. Results go in TEST_RESULTS.md.' && exit 1"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@genkit-ai/google-genai": "1.28.0",
    "@hookform/resolvers": "4.1.3",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@radix-ui/react-accordion": "1.2.3",
    "@radix-ui/react-alert-dialog": "1.1.6",
    "@radix-ui/react-avatar": "1.1.3",
    "@radix-ui/react-checkbox": "1.1.4",
    "@radix-ui/react-collapsible": "1.1.11",
    "@radix-ui/react-dialog": "1.1.6",
    "@radix-ui/react-dropdown-menu": "2.1.6",
    "@radix-ui/react-label": "2.1.2",
    "@radix-ui/react-menubar": "1.1.6",
    "@radix-ui/react-popover": "1.1.6",
    "@radix-ui/react-progress": "1.1.2",
    "@radix-ui/react-radio-group": "1.2.3",
    "@radix-ui/react-scroll-area": "1.2.3",
    "@radix-ui/react-select": "2.1.6",
    "@radix-ui/react-separator": "1.1.2",
    "@radix-ui/react-slider": "1.2.3",
    "@radix-ui/react-slot": "1.2.3",
    "@radix-ui/react-switch": "1.1.3",
    "@radix-ui/react-tabs": "1.1.3",
    "@radix-ui/react-toast": "1.2.6",
    "@radix-ui/react-tooltip": "1.1.8",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "3.6.0",
    "dotenv": "16.5.0",
    "embla-carousel-react": "8.6.0",
    "firebase": "11.9.1",
    "firebase-admin": "^14.5.0",
    "genkit": "1.28.0",
    "lucide-react": "0.475.0",
    "next": "15.5.9",
    "next-auth": "^5.0.0-beta.25",
    "react": "19.2.1",
    "react-day-picker": "9.11.3",
    "react-dom": "19.2.1",
    "react-hook-form": "7.54.2",
    "recharts": "2.15.1",
    "tailwind-merge": "3.0.1",
    "tailwindcss-animate": "1.0.7",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "15.5.9",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "16.2.0",
    "@types/node": "20.17.16",
    "@types/react": "19.2.1",
    "@types/react-dom": "19.2.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "9.19.0",
    "eslint-config-next": "15.5.9",
    "firebase-tools": "^15.23.0",
    "genkit-cli": "1.28.0",
    "jsdom": "^30.1.1",
    "pg": "^8.23.1",
    "playwright-core": "^1.60.0",
    "postcss": "8.5.1",
    "prettier": "3.4.2",
    "prettier-plugin-tailwindcss": "0.6.11",
    "prisma": "^7.10.0",
    "tailwindcss": "3.4.1",
    "typescript": "5.7.3",
    "vitest": "3.0.4"
  },
  "allowScripts": {
    "prisma@7.10.0": true,
    "@prisma/client@7.10.0": true
  },
  "overrides": {
    "jose": "^5.10.0"
  }
}
