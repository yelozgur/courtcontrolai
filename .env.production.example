# CourtControl AI: Production Environment
# Bu dosya production deployment icin ornek. Gercek secret'lari
# Firebase App Hosting console'dan veya `firebase apphosting:secrets:set` ile set edin.
# .env.production GERCEK DEGERLERLE commit edilmemeli, .gitignore'da olmali.

# === Firebase Client (NEXT_PUBLIC_*, browser'a bundle olur) ===
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyBxyoJTlKNejpHi33mxzeFoymwpPVNCn4w
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=courtcontrolai-2294b.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=courtcontrolai-2294b
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=courtcontrolai-2294b.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=159679715722
NEXT_PUBLIC_FIREBASE_APP_ID=1:159679715722:web:23a91a16bb8a5832041073

# Production'da emulator KAPALI
NEXT_PUBLIC_USE_EMULATOR=false

# === Server-side Secrets (NOT in NEXT_PUBLIC_*, only server) ===
# Google AI (Gemini 2.5 Flash-Lite)
# Anahtar yoksa tum AI ozellikleri kapali olur (skor optimizasyonu, AI planlama).
# API endpoint'leri 503 + ai_not_configured doner.
GOOGLE_GENAI_API_KEY=your-google-ai-key-here

# Telegram Bot (server route'undan server-side call)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# === NextAuth.js (Google OAuth) ===
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
AUTH_SECRET=your-auth-secret

# === Firebase Admin SDK (NextAuth bridge) ===
FIREBASE_ADMIN_PROJECT_ID=courtcontrolai-2294b
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@courtcontrolai-2294b.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# === Neon Postgres (Prisma datasource) ===
# Neon dashboard'dan (https://console.neon.tech) alinacak.
# Vercel Dashboard > Project > Settings > Environment Variables > Production
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host.neon.tech/dbname?sslmode=require"
POSTGRES_PRISMA_URL="postgresql://user:password@host-pooler.neon.tech/dbname?channel_binding=require&connect_timeout=15&sslmode=require"
POSTGRES_URL_NON_POOLING="postgresql://user:password@host.neon.tech/dbname?channel_binding=require&sslmode=require"
POSTGRES_URL="postgresql://user:password@host-pooler.neon.tech/dbname?channel_binding=require&sslmode=require"
POSTGRES_URL_NO_SSL="postgresql://user:password@host-pooler.neon.tech/dbname"
POSTGRES_HOST="host-pooler.neon.tech"
POSTGRES_HOST_UNPOOLED="host.neon.tech"
POSTGRES_DATABASE="dbname"
POSTGRES_USER="user"
POSTGRES_PASSWORD="password"
PGHOST="host-pooler.neon.tech"
PGHOST_UNPOOLED="host.neon.tech"
PGDATABASE="dbname"
PGUSER="user"
PGPASSWORD="password"
NEON_PROJECT_ID="your-neon-project-id"
NEON_AUTH_BASE_URL="https://host.neonauth.neon.tech/dbname/auth"
VITE_NEON_AUTH_URL="https://host.neonauth.neon.tech/dbname/auth"
